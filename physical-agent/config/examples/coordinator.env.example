# 总控的环境变量示例。这里全是占位符：真值只放在服务器的环境变量里，不要提交到仓库。

# 设备表：设备名 -> 类型（watch / phone / laptop / waker）和设备令牌。
# 令牌用 `python -c "import secrets; print(secrets.token_urlsafe(32))"` 生成。
PAGENT_DEVICES={"watch-1": {"kind": "watch", "token": "REPLACE_WITH_WATCH_TOKEN"}, "phone-1": {"kind": "phone", "token": "REPLACE_WITH_PHONE_TOKEN"}}

# 管理接口（PUT/DELETE /api/voice/session）的令牌。
PAGENT_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN

# Agora（用 --fake-agora 时不需要）。
# App ID：Agora Console 的项目页。Customer ID / Secret：Console 的 RESTful API Keys，
# 下载文件里的 Key 是 Customer ID，Secret 是 Customer Secret。
AGORA_APP_ID=REPLACE_WITH_APP_ID
AGORA_CUSTOMER_ID=REPLACE_WITH_CUSTOMER_ID
AGORA_CUSTOMER_SECRET=REPLACE_WITH_CUSTOMER_SECRET
